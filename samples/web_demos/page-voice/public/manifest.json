{
  "manifest_version": 3,
  "name": "Page Voice (dev)",
  "description": "Gives any page a voice. Local TTS on your GPU — text never leaves your device.",
  "version": "0.1.0",
  "minimum_chrome_version": "128",
  "permissions": ["offscreen", "contextMenus", "scripting", "activeTab", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Page Voice" },
  "commands": {
    "read-selection": {
      "suggested_key": { "default": "Alt+R" },
      "description": "Read the selected text aloud"
    },
    "stop-speaking": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Stop speaking"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" }
}
