Patch to flutter_litert 3.9.3 (https://pub.dev/packages/flutter_litert), applied by
tool/flutter_litert/vendor.sh into third_party/flutter_litert. flutter_litert, and this patch as
a modification of it, stay under flutter_litert's own licence, the Apache License 2.0
(third_party/flutter_litert/LICENSE after vendoring); this app's Apache-2.0 LICENSE at the
repository root does not replace it. Changed files: lib/src/bindings/litert_ffi.dart,
linux/CMakeLists.txt, windows/CMakeLists.txt (why: see the comments the patch adds).

--- a/lib/src/bindings/litert_ffi.dart
+++ b/lib/src/bindings/litert_ffi.dart
@@ -50,12 +50,23 @@
 /// ABI.
 final class LiteRtRankedTensorType extends Opaque {}
 
-/// ABI size of [LiteRtLayout] for the current platform.
-final int kLiteRtLayoutByteSize = Platform.isWindows ? 72 : 68;
+/// ABI size of [LiteRtLayout] for the loaded runtime.
+final int kLiteRtLayoutByteSize = _msvcBoolBitfieldLayout ? 72 : 68;
 
-/// ABI size of [LiteRtRankedTensorType] for the current platform.
-final int kLiteRtRankedTensorTypeByteSize = Platform.isWindows ? 76 : 72;
+/// ABI size of [LiteRtRankedTensorType] for the loaded runtime.
+final int kLiteRtRankedTensorTypeByteSize = _msvcBoolBitfieldLayout ? 76 : 72;
 
+/// litert_edge_demos patch: MSVC's 72/76 only for the runtime this plugin
+/// bundles on Windows (LiteRT 2.1.5, `bool has_strides : 1`). On Windows the
+/// app runs on LiteRT-LM's libLiteRt.dll (flutter_edge_ai_litertlm's native
+/// assets, beside the executable), built from a LiteRT where `has_strides`
+/// is an `unsigned int` bit-field: MSVC packs it with `rank` as clang/gcc do,
+/// 68/72 on every compiler (dimensions at offset 4). That runtime has the
+/// newer model-loading ABI ([_hasEnvironmentModelAbi]), which tells the two
+/// apart; with the MSVC sizes every shape it reads or writes is 4 bytes off.
+final bool _msvcBoolBitfieldLayout =
+    Platform.isWindows && !_hasEnvironmentModelAbi(litertDynamicLibrary);
+
 /// Byte offset of the layout field within [LiteRtRankedTensorType].
 const int kLiteRtRankedTensorTypeLayoutOffset = 4;
 
