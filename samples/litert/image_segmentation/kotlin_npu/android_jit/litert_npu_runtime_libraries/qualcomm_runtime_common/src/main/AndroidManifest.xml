<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:dist="http://schemas.android.com/apk/distribution">

    <!-- The device groups below are the union of the groups declared by every
         qualcomm_runtime_v* module, so this module is installed whenever one of
         them is. Keep it in sync when a new qualcomm_runtime_v* module is added. -->
    <dist:module
        dist:instant="false"
        dist:title="@string/title_qualcomm_runtime_common">
        <dist:delivery>
            <dist:install-time>
                <dist:conditions>
                    <dist:device-groups>
                        <dist:device-group dist:name="Qualcomm_SM7150"/>
                        <dist:device-group dist:name="Qualcomm_SM8250"/>
                        <dist:device-group dist:name="Qualcomm_SM8350"/>
                        <dist:device-group dist:name="Qualcomm_SM8450"/>
                        <dist:device-group dist:name="Qualcomm_SM8550"/>
                        <dist:device-group dist:name="Qualcomm_SM8650"/>
                        <dist:device-group dist:name="Qualcomm_SM8750"/>
                        <dist:device-group dist:name="Qualcomm_SM8850"/>
                    </dist:device-groups>
                </dist:conditions>
            </dist:install-time>
        </dist:delivery>
        <dist:fusing dist:include="true" />
    </dist:module>
</manifest>
