<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Only for downloading the model file from Hugging Face; reading a picture makes no network call. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <application android:allowBackup="false" android:label="@string/app_name" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:usesCleartextTraffic="false">
    <!-- singleTop: `adb shell am start` with new extras reaches the running screen (onNewIntent). -->
    <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!-- The camera app writes the photo into the app's cache through this provider. -->
    <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
    </provider>
  </application>
</manifest>
